Kernel#debugger call: (session.rb)
  DEBUGGER__.add_line_breakpoint(loc.path, loc.lineno+1, oneshot: true)
    SESSION.add_line_breakpoint
      bp = LineBreakpoint.new
        Session.try_activate
          nearest_iseq = iterate_iseq() # find nearest iseq
          activate_exact(nearest_iseq)
            activate
              @key = [@path, @line]
              setup
                @tp = TracePoint.new(@type) do # :line
                  delete if @oneshot
                  suspend
                    ThreadClient.current.on_breakpoint @tp, self
                      ThreadClient#suspend tp.event, tp, bp
                        event! :suspend, :breakpoint, bp.key
                          @q_evt << [self, @output, event, generate_info, [:breakpoint, bp.key]]
                          # this wakes the session server, which processes it
                        wait_next_action
                          _wait_next_action
                            @q_cmd.pop # blocking
                end
              enable
                @tp.enable(target: @iseq, target_line: @line)
      add_bp bp # @bps[bp.key] = bp

# When event queue is pushed to:
